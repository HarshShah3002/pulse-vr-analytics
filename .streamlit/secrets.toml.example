# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud > App settings > Secrets.
# Never commit the real secrets.toml.

# Read-only MotherDuck token for the app. Leave out to use the local warehouse/pulse.duckdb file.
MOTHERDUCK_TOKEN = "paste-read-only-token"

# OpenRouter key for AI briefings and Ask Pulse. Leave out to use template briefings.
OPENROUTER_API_KEY = "sk-or-..."
OPENROUTER_MODEL = "~anthropic/claude-sonnet-latest"
